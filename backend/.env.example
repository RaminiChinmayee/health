# Template only. Copy to backend/.env and put real values THERE. Never put real secrets in this file.

ENVIRONMENT=development            # development | test | production

# PostgreSQL (create the role/db once — see README)
DATABASE_URL=postgresql+psycopg://healthai:CHANGE_ME@127.0.0.1:5432/healthai

# Public origin of the web app. The API is reached at {FRONTEND_URL}/api.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------------------------------------------------------------- Email
# console = development only: emails are NOT sent, links are printed in the server log.
# smtp    = real delivery through the SMTP server below.
EMAIL_BACKEND=console
SMTP_HOST=                         # e.g. smtp.gmail.com, smtp-relay.brevo.com, smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=                     # e.g. youraccount@gmail.com
SMTP_PASSWORD=                     # Gmail: a 16-character App Password (needs 2-Step Verification), NOT your normal password
SMTP_USE_TLS=true                  # STARTTLS on 587
SMTP_USE_SSL=false                 # set true (and SMTP_USE_TLS=false) for port 465
EMAIL_FROM=HealthAssist AI <no-reply@yourdomain.com>

# ---------------------------------------------------------------- Google sign-in (optional)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI:  {FRONTEND_URL}/api/auth/google/callback
#   e.g. http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Chatbot / voice (Google Gemini)
# Key from https://aistudio.google.com/apikey . Without it the chatbot reports it is unavailable.
GEMINI_API_KEY=
# Optional overrides (defaults shown):
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_CHAT_FALLBACK_MODELS=["gemini-3.5-flash-lite"]
# GEMINI_TRANSCRIBE_MODELS=["gemini-3.5-transcribe","gemini-3.5-flash-lite"]
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# EMBEDDING_MODEL=intfloat/multilingual-e5-small     # local, downloads once (~470 MB)

# ---------------------------------------------------------------- Optional
# OSM_USER_AGENT=HealthAssistAI/0.1 (contact@yourdomain)   # OpenStreetMap asks for contact details in production
# REGISTER_MAX_PER_HOUR_PER_IP=10                          # raise only for automated testing
